# Copier ce fichier vers deploy.env ; ne jamais mettre les secrets dans Git.
POSTGRES_USER=syvaa
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
POSTGRES_DB=syvaa

JWT_ACCESS_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# URL publique du web autorisée à appeler l'API.
WEB_ORIGIN=http://localhost:3100
# Adresse publique de l'API intégrée au bundle web au moment du build.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# offline fonctionne sans secret fournisseur. Pour activer l'IA :
# AI_PROVIDER=huggingface et renseigner HF_TOKEN.
AI_PROVIDER=offline
HF_TOKEN=