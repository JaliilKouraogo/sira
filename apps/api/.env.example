# Copier ce fichier en .env puis compléter. Le fichier .env n'est jamais versionné.

# --- Serveur ---------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# Origines autorisées à appeler l'API avec cookies (séparées par des virgules).
WEB_ORIGIN=http://localhost:3100
# Derrière un proxy en production : nombre de proxys de confiance (ex. 1).
# TRUST_PROXY=1

# --- Base de données (docker compose up -d, à la racine du dépôt) ----------
DATABASE_URL=postgresql://sira:sira@localhost:5440/sira?schema=public
# Base vidée et recréée par les tests e2e.
DATABASE_URL_TEST=postgresql://sira:sira@localhost:5440/sira_test?schema=public

# --- Authentification ---------------------------------------------------------
# Au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30

# --- IA : Hugging Face ------------------------------------------------------
# Jeton gratuit : https://huggingface.co/settings/tokens (type « Read » suffit).
# Sans jeton, l'API fonctionne en mode hors ligne : le score reste calculé,
# les explications et l'assistant utilisent des réponses préparées.
HF_TOKEN=
# AI_PROVIDER=huggingface            # ou « offline » pour couper l'IA
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_STRUCTURED_MODEL=Qwen/Qwen3-4B-Instruct-2507
# HF_FALLBACK_MODEL=Qwen/Qwen3-4B-Instruct-2507
# HF_TIMEOUT_MS=30000

# --- Données de démonstration (npm run db:seed) ------------------------------
# Mot de passe commun aux comptes de démonstration, en local uniquement.
# SEED_DEMO_PASSWORD=Demo-SIRA-2026
